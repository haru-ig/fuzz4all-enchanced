#include <stdlib.h>
#include <stdio.h>
int main() {
    int x = 0;
    int y = 0;
    do {
        if (x == 3) {
            y++;
            if (y == 4) {
                goto next_step;
            } else if (y == 5) {
                goto error_exit;
            } else if (y == 3) {
                goto infinite_loop;
            } else {
                x--;
                goto error_exit;
            }
        }
    } while (x < 5);
    next_step:
    printf("Next step: %d\n", x);
    return 0;
    error_exit:
    printf("Error: Invalid x or y value.\n");
    return 1;
    infinite_loop:
    printf("Infinite loop!\n");
    while (1);
}
