#include <stdlib.h>


void error(int errorCode, const char* message) {
    printf("Error %d: %s\n", errorCode, message);
    exit(errorCode);
}

int main() {
    int choice = 0;

    while (choice != -1) {
        printf("Menu:\n");
        printf("1. Option 1\n");
        printf("2. Option 2\n");
        printf("3. Option 3\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Selected Option 1\n");
                break;
            case 2:
                printf("Selected Option 2\n");
                break;
            case 3:
                printf("Selected Option 3\n");
                break;
            case 4:
                printf("Exiting...\n");
                return 0;
            default:
                error(1, "Invalid choice. Try again.");
                break;
        }
    }

    return 0;
}