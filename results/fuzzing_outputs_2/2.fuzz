#include <stdlib.h>

int main() {
int a = 10;
int b = 20;
int c = 30;
printf("a, b, c: %d, %d, %d\n", a, b, c);
if (a < 20) {
printf("a is less than 20\n");
} else if (a > 20) {
printf("a is greater than 20\n");
} else {
printf("a is equal to 20\n");
}
switch (b) {
case 10:
printf("b is 10\n");
break;
case 20:
printf("b is 20\n");
break;
case 30:
printf("b is 30\n");
break;
default:
printf("b is not 10, 20, or 30\n");
}
}
