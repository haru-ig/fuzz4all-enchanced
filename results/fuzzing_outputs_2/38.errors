#include <stdlib.h>
#include <stdio.h>
int main() {
    int x = 0;
    int y = 0;
    while (x < 5) {
        if (x == 3) {
            y++;
            if (y == 5) {
                goto next_step;
            } else if (y == 6) {
                goto error_exit;
            } else if (y == 2) {
                goto infinite_loop;
            } else {
                x--;
                goto error_exit;
            }
        }
    }
    next_step:
    printf("Next step: %d\n", x);
    return 0;
    error_exit:
    printf("Error: Invalid x or y value.\n");
    return 1;
    infinite_loop:
    printf("Infinite loop!\n");
    while (1);
}
 
#include <stdlib.h>
#include <stdio.h>
int main() {
    int x = 0;
    int y = 0;
    while (x < 6) {
        if (x == 3) {
            y++;
            if (y == 5) {
                goto next_step;
            } else if (y == 6) {
                goto error_exit;
            } else if (y == 2) {
                goto infinite_loop;
            } else {
                x--;
                goto error_exit;
            }
        }
    }
    next_step:
    printf("Next step: %d\n", x);
    return 0;
    error_exit:
    printf("Error: Invalid x or y value.\n");
    return 1;
    infinite_loop:
    printf("Infinite loop!\n");
    while (1);
}
