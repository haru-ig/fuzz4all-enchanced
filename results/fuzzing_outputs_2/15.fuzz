#include <stdio.h>
int main() {
    int x = 0;
    int y = 0;
    while (1) {
        if (x == 0) {
            y++;
            if (y == 1) {
                x++;
            } else if (y == 2) {
                x--;
            } else {
                y = 0;
            }
        }
    }
    printf("Next step: %d\n", x);
    return 0;
}
 
#include <stdio.h>
int main() {
    int x = 0;
    int y = 0;
    while (1) {
        if (x == 0) {
            y++;
            if (y == 1) {
                x++;
            } else if (y == 2) {
                x--;
            } else {
                y = 0;
            }
        } else if (x == 1) {
            y--;
            if (y == -1) {
                x = 0;
            } else if (y == -2) {
                x = 2;
            } else {
                y = 0;
            }
        } else if (x == 2) {
            y++;
            if (y == 0) {
                x = 3;
            } else if (y == 1) {
                x = 4;
            } else {
                y = 0;
            }
        } else if (x == 3) {
            y++;
            if (y == 2) {
                x = 0;
            } else if (y == 3) {
                x = 1;
            } else {
                y = 0;
            }
        } else {
            y--;
            if (y == -2) {
                x = 1;
            } else if (y == -3) {
                x = 0;
            } else {
                y = 0