#include <stdlib.h>
#include <stdio.h>
int main() {
    int x = 0;
    int y = 0;
    while (x < 5) {
        if (x == 5) {
            y++;
            if (y == 5) {
                break;
            } else if (y == 6) {
                return 1;
            } else if (y == 2) {
                while (1);
            } else {
                printf("Error: Invalid x or y value.\n");
                return 1;
            }
        }
        printf("Next step: %d\n", x);
        return 0;
    }
}
