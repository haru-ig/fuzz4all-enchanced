#include <stdlib.h>


int main() {
    int* arr;
    int size = 5;
    int i;

     
    arr = (int*)malloc(size * sizeof(int));
    if (arr == NULL) {
        printf("Error: Memory allocation failed!\n");
        return 1;
    }

     
    for (i = 0; i < size; i++) {
        arr[i] = 0;
    }

     
    free(arr);

    return 0;
}

 
}
 
     
