#include <stdlib.h>
#include <stdio.h>
int main() {
    int x = 0;
    int y = 0;
    if (x == 0) {
        while (x < 4) {
            if (y < 5) {
                if (y == 4) {
                    y++;
                    if (y == 4) {
                        printf("Error: Invalid x or y value.\n");
                        return 1;
                    } else {
                        printf("Infinite loop!\n");
                        while (1);
                    }
                }
            } else {
                printf("Error: Invalid x or y value.\n");
                return 1;
            }
        }
    }
    x++;
    if (x == 0) {
        printf("Next step: %d\n", x);
        return 0;
    } else {
        printf("Error: Invalid x or y value.\n");
        return 1;
    }
}
 
