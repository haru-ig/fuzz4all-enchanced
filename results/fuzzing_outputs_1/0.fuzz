#include <stdlib.h>

#include <stdio.h>

int main()
{
     
    int *my_integers = malloc(sizeof(int)*20);

     
    if (my_integers == NULL)
    {
         
        return EXIT_FAILURE;
    }

     
    for(int i = 0; i < 20; i++)
    {
         
        int num = (int) rand() % 20;

         
        my_integers[i] = num;
    }

     
    for(int i = 0; i < 20; i++)
    {
        if(my_integers[i] % 2 == 0)
        {
            printf("Number %d is even.\n", my_integers[i]);
        }
        else
        {
            printf("Number %d is odd.\n", my_integers[i]);
        }
    }

     
    free(my_integers);

     
    return EXIT_SUCCESS;
}
