int main() {
    int error_condition = 0;
    if (error_condition) {
        goto error;
    }

    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 3; j++) {
            printf("i = %d, j = %d\n", i, j);
            if (i == 2 && j == 1) {
                goto outer_loop;
            }
        }
    }

